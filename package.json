    "adm-zip": "^0.5.10",
    "autoprefixer": "^10.4.13",
    "axios": "^1.2.6",
    "better-auth": "^1.6.11",
    "buffer": "^6.0.3",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.0.0",
    "date-fns": "^2.30.0",
    "dompurify": "^2.4.3",
    "dotenv": "^16.0.3",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fast-json-stable-stringify": "^2.1.0",
    "fuse.js": "^7.1.0",
    "immer": "^10.0.1",
    "jsts": "^2.12.1",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "maplibre-gl": "^5.13.0",
    "maplibre_symbol_utils": "^0.1.3",
    "micro-observables": "^1.7.2",
    "notistack": "^3.0.1",
    "overlayscrollbars": "^2.12.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.2.5",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.5",
    "react-ga": "^3.3.1",
    "react-photo-album": "^3.1.0",
    "react-router-dom": "^7.2.0",
    "react-window": "^1.8.11",
    "shpjs": "^4.0.4",
    "terra-draw": "^1.19.0",
    "terra-draw-maplibre-gl-adapter": "^1.2.2",
