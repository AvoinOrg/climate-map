{
  "name": "avoin-map",
  "version": "1.0.0",
  "repository": "git@github.com:AvoinOrg/avoin-map.git",
  "license": "SSPL-1.0",
  "scripts": {
    "start": "yarn start:preview",
    "dev": "yarn start:dev",
    "clean": "rm -rf .output .tanstack .nitro node_modules/.cache",
    "prebuild-dev": "node ./utils/scripts/downloadTranslations.js",
    "prebuild": "yarn run prebuild-dev && node ./utils/scripts/prebuildFolderPruneTmp.js",
    "build": "yarn run prebuild && node ./utils/scripts/buildFromFolderPruneTmp.js",
    "build:netlify": "START_TARGET=netlify yarn run build",
    "build-prune": "yarn run build",
    "start:dev": "vite dev --config vite.config.mts",
    "start:build": "vite build --config vite.config.mts",
    "start:preview": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=production\" PORT=${PORT:-3002} node .output/server/index.mjs",
    "start:typecheck": "tsc --project tsconfig.json --noEmit",
    "start:auth-smoke": "node --import tsx utils/scripts/start-auth-contract-smoke.ts",
    "lint": "eslint .",
    "test": "jest",
    "test:luonnonmetsakartat": "jest --config ./jest.luonnonmetsakartat.config.ts --runInBand",
    "test:watch": "jest --watch",
    "test:watch-changed": "jest --watch --onlyChanged",
    "visual:install": "npx playwright install chromium",
    "visual:webgl:smoke": "node ./utils/scripts/visual/webgl-smoke.js --browser-mode=xvfb-webgl --expect-webgl=available",
    "visual:webgl:smoke:headless": "node ./utils/scripts/visual/webgl-smoke.js --browser-mode=headless --expect-webgl=unavailable",
    "visual:baseline": "node ./utils/scripts/visual/run.js --mode=baseline --base-url=http://127.0.0.1:6900",
    "visual:changed": "node ./utils/scripts/visual/run.js --mode=changed --base-url=http://127.0.0.1:6900",
    "visual:carbon-mocks": "node ./utils/scripts/visual/run.js --mode=changed --scenario-set=carbon-mocks --base-url=http://127.0.0.1:6900 --no-start",
    "visual:luonnonmetsakartat-mocks": "node ./utils/scripts/visual/run.js --mode=changed --scenario-set=luonnonmetsakartat-mocks --base-url=http://127.0.0.1:6900 --no-start",
    "visual:carbon-mocks:smoke": "node ./utils/scripts/visual/carbon-mock-smoke.js --base-url=http://127.0.0.1:6900 --no-start",
    "visual:luonnonmetsakartat-mocks:smoke": "node ./utils/scripts/visual/luonnonmetsakartat-mock-smoke.js --base-url=http://127.0.0.1:6900 --no-start",
    "luonnonmetsakartat:mock:smoke": "node ./utils/scripts/visual/luonnonmetsakartat-mock-smoke.js --base-url=http://127.0.0.1:6900 --no-start",
    "visual:after-edit": "node ./utils/scripts/visual/after-edit.js",
    "browser-state:sync:localhost": "node ./utils/scripts/visual/sync-host-chrome-state.js",
    "visual:baseline:host-state": "node ./utils/scripts/visual/run.js --mode=baseline --base-url=http://localhost:6900 --storage-state=.dev/browser-state/localhost-6900.storage-state.json",
    "visual:changed:host-state": "node ./utils/scripts/visual/run.js --mode=changed --base-url=http://localhost:6900 --storage-state=.dev/browser-state/localhost-6900.storage-state.json",
    "visual:after-edit:host-state": "node ./utils/scripts/visual/after-edit.js --base-url=http://localhost:6900 --storage-state=.dev/browser-state/localhost-6900.storage-state.json",
    "browser:live:lock:status": "node ./utils/scripts/visual/live-control-lock.js status",
    "browser:live:lock:take:codex": "node ./utils/scripts/visual/live-control-lock.js take --owner=codex --mode=host-cdp",
    "browser:live:lock:take:human": "node ./utils/scripts/visual/live-control-lock.js take --owner=human --mode=host-cdp",
    "browser:live:lock:release": "node ./utils/scripts/visual/live-control-lock.js release --owner=codex",
    "browser:live:host:check": "node ./utils/scripts/visual/live-host-browser.js --check --no-open-if-missing",
    "browser:live:host:attach": "node ./utils/scripts/visual/live-host-browser.js",
    "browser:live:container:start": "node ./utils/scripts/visual/live-container-browser-start.js",
    "browser:live:container:attach": "node ./utils/scripts/visual/live-container-browser-attach.js",
    "browser:live:container:stop": "node ./utils/scripts/visual/live-container-browser-stop.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@esri/arcgis-to-geojson-utils": "^1.3.0",
