# Copy this file to .env and set values for your environment. Never commit
# credentials. Every PUBLIC_* value is embedded in browser code and is visible
# to users; secrets and upstream credentials must use server-only names.

# Local container/runtime configuration
# -------------------------------------

# Host port published by Docker Compose.
DEV_PORT=6900
# Compose file selected by local Docker commands.
COMPOSE_FILE=docker-compose.dev.yml

# Optional host folder for the shared-browser persistent profile.
# LIVE_BROWSER_CONTAINER_DATA_HOST_DIR=./.dev/live-browser-persist

# Host SSH agent socket directory used by the devcontainer.
# SSH_AGENT_DIR=/home/<you>/.ssh/sockets

# Public browser/build configuration
# ----------------------------------

# Canonical applet build selection. Include main for a full build; without main,
# exactly one applet is required for standalone mode.
PUBLIC_COMPILED_APPLETS=main

# Optional applet-domain overrides consumed by Netlify redirect generation.
# Names are derived from appletConf.json namespaces.
# PUBLIC_APPLET_CARBON_DOMAIN=https://carbon.example.org
# PUBLIC_APPLET_ENERGY_DOMAIN=https://energy.example.org
# PUBLIC_APPLET_LUONNONMETSAKARTAT_DOMAIN=https://forests.example.org

# Set to 1 at build time for readable production client/server stack traces.
# PUBLIC_DEBUG_CLIENT_ERRORS=1

# Public Umami script and applet website IDs; both are required for analytics.
# PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.org/umami.js
# PUBLIC_APPLETS_HIILIKARTTA_UMAMI_ID=
# PUBLIC_APPLETS_ENERGIAKARTTA_UMAMI_ID=
# PUBLIC_APPLETS_LUONNONMETSAKARTAT_UMAMI_ID=

# Canonical public GeoServer endpoints used by browser map requests. Legacy
# NEXT_PUBLIC_* aliases are unsupported and are not exposed to browser code.
PUBLIC_GEOSERVER_URL=https://gis.example.org/geoserver
PUBLIC_ENERGIAKARTTA_GEOSERVER_URL=https://sandbox.gis.avoin.org/geoserver

# Statistics/detail service origin; does not choose dataset versions or enable map coverage.
PUBLIC_ENERGY_AREA_API_ORIGIN=https://energy-service-test.avoin.org

# Canonical public Luonnonmetsakartat GeoServer workspace name.
PUBLIC_LUONNONMETSAKARTAT_GEOSERVER_WORKSPACE=luonnonmetsakartat

# Optional browser-visible Terramonitor tile token. Restrict it provider-side;
# it is embedded in requested tile URLs and is not a secret.
# PUBLIC_TERRAMONITOR_KEY=

# Public Zitadel base URL used only for browser links to the user console.
PUBLIC_ZITADEL_ISSUER=https://auth.example.org

# Local/test-only browser mock auth. Production explicitly refuses these flags.
PUBLIC_MOCK_AUTH_ENABLED=0
PUBLIC_MOCK_AUTH_INITIAL_STATE=authenticated

# Local/test-only client scenario bootstraps. Production refuses both flags.
PUBLIC_HIILIKARTTA_MOCK_SCENARIOS_ENABLED=0
PUBLIC_LUONNONMETSAKARTAT_MOCK_SCENARIOS_ENABLED=0

# Server/build-only configuration
# -------------------------------

# Tolgee export/upsert endpoint and credential used by build scripts only.
TOLGEE_API_URL=https://tolgee.example.org
TOLGEE_API_KEY=

# Optional Start deployment target; yarn build:netlify sets this automatically.
# START_TARGET=netlify

# Optional override for generated Netlify proxy targets. Netlify normally
# supplies DEPLOY_PRIME_URL or URL.
# NETLIFY_REDIRECTS_BASE_URL=https://deploy-preview.example.netlify.app

# Keep the temporary pruned build workspace for diagnostics.
# BUILD_TMP_KEEP=1

# Better Auth and Zitadel OIDC server configuration. Production requires
# explicit Better Auth URL/secret values.
ZITADEL_ISSUER=https://auth.example.org
ZITADEL_CLIENT_ID=123123@zitadel-project
ZITADEL_CLIENT_SECRET=
# Project whose roles the protected service validates; used to build its
# audience scope.
ZITADEL_PROJECT_ID=replace-with-zitadel-project-id
BETTER_AUTH_URL=http://localhost:6900
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional callback override and comma-separated trusted origins.
# ZITADEL_REDIRECT_URI=http://localhost:6900/api/auth/callback/zitadel
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:6900,http://127.0.0.1:6900

# Server-only National Land Survey proxy credential.
MML_API_KEY=

# Server-only upstream API endpoints.
HIILIKARTTA_API_URL=https://hiilikartta-api.example.org
LUONNONMETSAKARTAT_API_URL=https://luonnonmetsakartat-api.example.org

# Local/test-only in-process API mocks. Production refuses both flags.
HIILIKARTTA_MOCK_API_ENABLED=0
LUONNONMETSAKARTAT_MOCK_API_ENABLED=0
